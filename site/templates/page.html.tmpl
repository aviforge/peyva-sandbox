{{define "try-turn"}}
      <p class="prompt-divider">{{if .Numbered}}<span class="prompt-step">{{.Step}} of {{.Steps}}</span> {{end}}{{.Label}}<span class="prompt-you" title="This turn is yours. Nothing here is sent to the assistant.">You</span></p>
      <div class="try-turn">
        <div class="try-text">{{.Text}}</div>
        {{if .Commands}}<p class="try-run">Run from the folder that holds peyva/.</p>{{end}}
        {{range .Commands}}
        <div class="prompt-wrap try-command" data-runner-for="{{.SystemID}}">
          <button type="button" class="prompt-copy" data-copy-prompt aria-label="Copy this command to clipboard" title="Copy this command">
            <svg class="icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="icon-copied" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <pre class="prompt">{{.Command}}</pre>
        </div>
        {{end}}
      </div>
{{end}}
{{define "page"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{.Chapter.Title}} | Peyva Sandbox</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%233b6ef6'/%3E%3Ctext x='12' y='17' font-family='Arial,sans-serif' font-size='14' font-weight='700' fill='white' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="{{.AssetPrefix}}styles.css?v={{.StyleVersion}}">
</head>
<body data-chapter-slug="{{.Chapter.Slug}}">
<button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle chapter menu">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
</button>
<div class="sidebar-backdrop" data-sidebar-backdrop></div>
<div class="layout">
{{template "sidebar" .}}
<main class="content">
  <div class="overall-progress" data-progress>
    <div class="overall-progress-track">
      <div class="overall-progress-fill" data-progress-fill></div>
    </div>
    <span class="overall-progress-label" data-progress-label>0% complete</span>
  </div>

  <div class="chapter-header">
    <button type="button" class="mark-complete" data-mark-complete>Mark chapter as complete</button>
    <p class="chapter-eyebrow">Chapter {{.Chapter.Number}}</p>
    <h1>{{.Chapter.Title}}</h1>
    <p class="chapter-subtitle">{{.Chapter.Subtitle}}</p>
    <div class="tags">
      <span class="tag">{{.Chapter.Category}}</span>
      <span class="tag">{{.Chapter.Difficulty}}</span>
    </div>
  </div>

  <figure class="hero-panel">
    {{if .HeroAvailable}}<a class="hero-link" href="{{.AssetPrefix}}{{.Chapter.HeroImage}}" target="_blank" rel="noopener"><img src="{{.AssetPrefix}}{{.Chapter.HeroImage}}" alt="{{.Chapter.HeroCaption}}"></a>{{else}}<div class="panel-placeholder">Image pending<br><code>{{.Chapter.HeroImage}}</code></div>{{end}}
    <figcaption>{{.Chapter.HeroCaption}}{{if .HeroAvailable}} <a class="hero-expand-hint" href="{{.AssetPrefix}}{{.Chapter.HeroImage}}" target="_blank" rel="noopener">Click to view full size</a>{{end}}</figcaption>
  </figure>

  {{if .Setup}}
  <section class="block setup" id="setup">
    <h2>Setup <span class="badge">Once</span>
        {{if .LanguageIsChosenHere}}<label class="language-picker">Build in
          <select class="language-select" data-language-select aria-label="Language every chapter&#39;s prompt asks for">
            <option value="" data-unset>Choose one</option>
            {{range .Languages}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
          </select>
        </label>{{end}}
        {{if .SystemIsChosenHere}}<label class="language-picker">On
          <select class="language-select" data-system-select aria-label="Operating system every command and script is written for">
            <option value="" data-unset>Choose one</option>
            {{range .Systems}}<option value="{{.ID}}" data-prompt="{{.Prompt}}">{{.Name}}</option>{{end}}
          </select>
        </label>{{end}}
    </h2>
    <ul class="lead">
      <li>{{len .Setup}} files, saved before you write a line of code.</li>
    </ul>
    {{range .Setup}}
    <p class="prompt-divider">{{.Path}}</p>
    <ul class="lead">
      <li>{{.Purpose}}</li>
    </ul>
    {{if .Names}}
    <p class="setup-note">No single filename is read by every assistant, so save this under the name yours looks for. The contents are identical either way.</p>
    <ul class="agent-files">
      {{range .Names}}<li><span class="agent-tool">{{.Tool}}</span> <code>{{.Path}}</code></li>{{end}}
    </ul>
    {{end}}
    <div class="prompt-wrap">
      <button type="button" class="prompt-copy" data-copy-prompt aria-label="Copy this file to clipboard" title="Copy this file">
        <svg class="icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <svg class="icon-copied" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      </button>
      <pre class="prompt">{{.Content}}</pre>
    </div>
    {{end}}
  </section>
  {{end}}

  <div class="section-grid">
    <section class="block">
      <h2>1. What</h2>
      <ul class="concepts">
        {{range .Chapter.Concepts}}<li><strong>{{.Term}}</strong>. {{.Description}}</li>{{end}}
      </ul>
    </section>

    <section class="block why">
      <h2>2. Why</h2>
      <ul class="why-list">
        {{range .Chapter.Why}}<li>{{.}}</li>{{end}}
      </ul>
    </section>

    {{with .Chapter.Aside}}
    <section class="block aside">
      <h2>Sidebar: {{.Title}} <span class="badge badge-aside">Sidebar</span></h2>
      <figure class="hero-panel aside-panel">
        {{if $.AsideHeroAvailable}}<a class="hero-link" href="{{$.AssetPrefix}}{{.HeroImage}}" target="_blank" rel="noopener"><img src="{{$.AssetPrefix}}{{.HeroImage}}" alt="{{.HeroCaption}}"></a>{{else}}<div class="panel-placeholder">Image pending<br><code>{{.HeroImage}}</code></div>{{end}}
        <figcaption>{{.HeroCaption}}{{if $.AsideHeroAvailable}} <a class="hero-expand-hint" href="{{$.AssetPrefix}}{{.HeroImage}}" target="_blank" rel="noopener">Click to view full size</a>{{end}}</figcaption>
      </figure>
      <ul class="why-list">
        {{range .Why}}<li>{{.}}</li>{{end}}
      </ul>
      <p class="technique"><span class="technique-name">{{.BuildIt.Technique}}</span>. {{.BuildIt.Why}}</p>
      <p class="technique-source">Documented in {{.BuildIt.Source}}</p>
      {{range $.AsidePrompts}}
      {{if .Reader}}{{template "try-turn" .}}{{else}}
      <p class="prompt-divider">{{if .Numbered}}<span class="prompt-step">{{.Step}} of {{.Steps}}</span> {{end}}{{.Label}}<span class="prompt-tokens" title="Roughly what this prompt costs to send, the rules above included. What the assistant then reads and writes is far larger and only your own tool can measure it.">~{{.Tokens}} tokens</span></p>
      <div class="prompt-wrap" data-prompt-rules="{{if .Thinking}}rules-thinking{{else if .Portal}}rules-portal{{else}}rules-build{{end}}">
        <button type="button" class="prompt-copy" data-copy-prompt aria-label="Copy this prompt to clipboard" title="Copy this prompt">
          <svg class="icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <svg class="icon-copied" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
        <pre class="prompt">{{.Text}}</pre>
      </div>
      {{end}}
      {{end}}
    </section>
    {{end}}

    <section class="block build-it">
      <h2>3. How <span class="badge">Hands-on</span>
          <span class="language-locked">Building in <b data-language-name>{{.LanguageName}}</b>, {{if .LanguageIsChosenHere}}<a href="#setup">change in Setup</a>{{else}}<a href="{{.AssetPrefix}}chapter-0.html">change in Chapter 0</a>{{end}}</span>
      </h2>
      <p class="choice-gate" data-choice-gate>Two choices first: the language you are building in, and the system you are on. Make them in {{if .LanguageIsChosenHere}}<a href="#setup">Setup, above</a>{{else}}<a href="{{.AssetPrefix}}chapter-0.html">Chapter 0</a>{{end}}. The prompts below stay locked until you do.</p>
      {{if .SystemMatters}}<p class="system-locked">Written for <b data-os-name>{{.SystemName}}</b>, <a href="{{.AssetPrefix}}{{.SystemPickerHref}}">change in Chapter {{.SystemPickerNumber}}</a></p>{{end}}
      <p class="technique"><span class="technique-name">{{.Chapter.BuildIt.Technique}}</span>. {{.Chapter.BuildIt.Why}}</p>
      <p class="technique-source">Documented in {{.Chapter.BuildIt.Source}}</p>
      <details class="standing-rules">
        <summary>Every prompt below is copied with these rules{{if .ChapterTokens}}, about {{.ChapterTokens}} tokens for the chapter{{end}}</summary>
        {{if .HasBuildPrompt}}<pre class="prompt-lang" id="rules-build">{{.LanguageLine}}</pre>{{end}}
        {{if .HasPortalPrompt}}<pre class="prompt-lang" id="rules-portal">{{.UILine}}</pre>{{end}}
        {{if .HasThinkingPrompt}}<pre class="prompt-lang" id="rules-thinking">{{.ThinkingLine}}</pre>{{end}}
      </details>
      {{range .Prompts}}
      {{if .Reader}}{{template "try-turn" .}}{{else}}
      <p class="prompt-divider">{{if .Numbered}}<span class="prompt-step">{{.Step}} of {{.Steps}}</span> {{end}}{{.Label}}<span class="prompt-tokens" title="Roughly what this prompt costs to send, the rules above included. What the assistant then reads and writes is far larger and only your own tool can measure it.">~{{.Tokens}} tokens</span></p>
      <div class="prompt-wrap" data-prompt-rules="{{if .Thinking}}rules-thinking{{else if .Portal}}rules-portal{{else}}rules-build{{end}}">
        <button type="button" class="prompt-copy" data-copy-prompt aria-label="Copy this prompt to clipboard" title="Copy this prompt">
          <svg class="icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <svg class="icon-copied" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
        <pre class="prompt">{{.Text}}</pre>
      </div>
      {{end}}
      {{end}}
      {{if .RunnerScripts}}
      <p class="prompt-divider">The runner</p>
      <ul class="lead">
        <li>Save this beside your code. Set the commands at the top to how your project starts. Two are blank until the chapter that builds them.</li>
      </ul>
      {{range .RunnerScripts}}
      <div class="prompt-wrap runner-script" data-runner-for="{{.SystemID}}">
        <p class="runner-path"><code>{{.Path}}</code></p>
        <button type="button" class="prompt-copy" data-copy-prompt aria-label="Copy the runner script to clipboard" title="Copy the runner script">
          <svg class="icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <svg class="icon-copied" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
        <pre class="prompt">{{.Content}}</pre>
      </div>
      {{end}}
      {{end}}
    </section>

  </div>

  <p class="quick-tip"><strong>Quick tip:</strong> {{.Chapter.QuickTip}}</p>
</main>
</div>
<script src="{{.AssetPrefix}}app.js?v={{.ScriptVersion}}"></script>
</body>
</html>
{{end}}
